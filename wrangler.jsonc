{
  // Cloudflare Workers (static assets) config. The site is plain files served
  // from the repo root; this file only tells Cloudflare how to serve them.
  "name": "friendly-spaces",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
